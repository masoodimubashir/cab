# Copy this file to keystore.properties in this directory (ignored by Git).
# The default keystore is USER_HOME/CabbiesSigning/cabbies-upload.jks.
# Optional override: use forward slashes, e.g. C:/Users/masud/CabbiesSigning/cabbies-upload.jks
# storeFile=C:/Users/masud/CabbiesSigning/cabbies-upload.jks
keyAlias=upload
storePassword=
# Leave keyPassword empty to use storePassword.
keyPassword=
