<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always show a launch window: keep it plain white with no icon, so the app
         seems to open straight on the welcome page. No splash (Saqib, 2026-11-26). -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
