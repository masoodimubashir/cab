# ===========================================================================
# DreamCabs PRODUCTION env (Docker Compose stack).
# Copy this to `.env` on the server:   cp .env.production.example .env
# Then fill in the values marked >>> CHANGE <<<.
# ===========================================================================
APP_NAME=DreamCabs
APP_ENV=production
APP_KEY=                       # leave blank — generated automatically on first boot
APP_DEBUG=false
APP_URL=http://REPLACE_WITH_SERVER_IP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---- Database (the `mysql` service inside the compose network) ------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dreamcabs
DB_USERNAME=dreamcabs
DB_PASSWORD=CHANGE_ME_db_password           # >>> CHANGE <<<
DB_ROOT_PASSWORD=CHANGE_ME_root_password    # >>> CHANGE <<<  (used by mysql container)

# ---- Laravel infra (database-backed; no Redis needed for a first deploy) --
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ---- Broadcasting / Reverb websockets -------------------------------------
# CRITICAL: this MUST be `reverb` (the example shipped with `log`, which
# silently disables real-time ride updates).
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=dreamcabs
# This key MUST match `reverbAppKey` in the mobile apps' environment.prod.ts.
REVERB_APP_KEY=4jsb8ggrbvcriyaskojh
REVERB_APP_SECRET=CHANGE_ME_reverb_secret   # >>> CHANGE <<<  (any long random string)

# Where Laravel PUSHES events to (the reverb container, inside the network).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Where the reverb process BINDS (inside its container).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ---- Firebase Admin (push + phone auth verification) ----------------------
# Put your service-account JSON at  backend/deploy/secrets/firebase.json
# It is mounted read-only into every PHP container at /secrets/firebase.json.
FIREBASE_CREDENTIALS_PATH=/secrets/firebase.json

# ---- Razorpay (UPI payments) — replace test keys with LIVE keys for prod ---
RAZORPAY_KEY_ID=rzp_test_Ssm635eZn4mTVQ
RAZORPAY_KEY_SECRET=f2tbErqiI5w2x2i64PU21Ksg
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ---- Mail (logs to file until you wire a real SMTP provider) --------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dreamcabs.app"
MAIL_FROM_NAME="${APP_NAME}"
